# Cloudflare Workers static assets: real response headers (parsed by Workers, not served as a file).
# Every page also keeps its own stricter <meta> CSP; browsers enforce both, so the header CSP
# below must allow the union of all pages' connect-src (test/headers.test.js checks this).
# Only ONE rule may set each header: matching rules are merged with a comma.

/*
  Content-Security-Policy: default-src 'self'; img-src 'self' https: data:; style-src 'self'; script-src 'self'; connect-src 'self' https://wrlsgqfpcvdjzsueikxw.supabase.co https://api.dexscreener.com https://api.geckoterminal.com https://api.rugcheck.xyz https://solana-rpc.publicnode.com https://public.rpc.solanavibestation.com https://rpc.solanatracker.io; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Live data rewritten by the engine every ~15 min; pages fetch it with cache: no-store anyway.
/data/*
  Cache-Control: public, max-age=60, must-revalidate

# Not content-hashed (tip-wallet.js is ?v=hash), so keep it short and revalidate.
/assets/*
  Cache-Control: public, max-age=3600, must-revalidate

https://:name.:sub.workers.dev/*
  X-Robots-Tag: noindex
