{
  "name": "maxigems",
  "version": "1.0.0",
  "description": "MaxiGems — automated Solana memecoin calls for Telegram + live calls website. Free APIs only.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js --loop",
    "once": "node src/index.js --once",
    "dry": "DRY_RUN=1 node src/index.js --once",
    "recap": "node src/index.js --recap",
    "serve": "node scripts/serve.js",
    "test": "node --test test/*.test.js",
    "build:tip": "node scripts/build-tip.mjs",
    "build:pay": "node scripts/build-pay.mjs",
    "test:functions": "PATH=$HOME/.deno/bin:$PATH deno test -A --no-lock supabase/functions/tests/",
    "check:sql": "node scripts/check-migrations.mjs",
    "check:sql:featured": "node scripts/check-featured-migration.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@solana-program/system": "^0.15.0",
    "@solana/kit": "^8.4.0",
    "@wallet-standard/app": "^1.1.1",
    "esbuild": "0.28.2"
  }
}
